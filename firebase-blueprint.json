{
  "mode": "single-player",
  "entities": {
    "PlayerSave": {
      "title": "Progresso individual do estudante",
      "description": "Backup privado de níveis, XP, ranks, apostilas, simulados e estatísticas.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID do proprietário" },
        "displayName": { "type": "string", "description": "Nome escolhido pelo estudante" },
        "avatar": { "type": "string", "description": "Avatar da jornada" },
        "bio": { "type": "string", "description": "Manifesto pessoal" },
        "selectedTitle": { "type": "string", "description": "Título de conquista equipado" },
        "level": { "type": "number", "description": "Nível de maestria atual" },
        "totalXP": { "type": "number", "description": "XP pessoal acumulado" },
        "weeklyXP": { "type": "number", "description": "XP pessoal conquistado na semana" },
        "rank": { "type": "object", "description": "Rank permanente atual" },
        "stats": { "type": "object", "description": "Desempenho acadêmico individual" },
        "achievements": { "type": "object", "description": "Conquistas desbloqueadas" },
        "updatedAt": { "type": "number", "description": "Última atualização" }
      },
      "required": ["id", "level", "totalXP", "rank", "stats"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/PlayerSave" },
      "description": "Documento privado acessível somente pelo próprio estudante"
    },
    "solo_questions/{questionId}": {
      "description": "Questões temporárias emitidas pelo servidor; sem acesso direto do cliente"
    },
    "processed_events/{eventId}": {
      "description": "Controle privado de duplicidade com expiração automática"
    }
  }
}
