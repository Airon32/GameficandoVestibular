# Porta HTTP opcional (padrão: 3000)
PORT=3000

# Em desenvolvimento local, a API administrativa do Firebase precisa de uma
# conta de serviço. Use um caminho fora do repositório e nunca versione a chave.
GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\seguro\firebase-service-account.json

# Na Vercel, salve o JSON completo da mesma conta de serviço como um secret.
# Não coloque a credencial real neste arquivo nem no GitHub.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"seu-projeto"}
